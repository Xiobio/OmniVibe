<Window x:Class="CodeManager.DockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodeManager" Title="CodeManager · AI 任务武器栏" Width="252" Height="748" WindowStyle="None" ResizeMode="NoResize" Background="{x:Static local:WuxiaTheme.Wood}" Foreground="#E5D8B9" Topmost="True" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#9C8150" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="DockFrame" Background="{x:Static local:WuxiaTheme.Wood}" BorderBrush="#8D7449" BorderThickness="1" Padding="12" CornerRadius="2">
    <Grid>
      <local:QiParticles x:Name="DockParticles" Opacity="0.35"/>
      <Grid x:Name="FullView">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,2,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <SystemThumb:Thumb xmlns:SystemThumb="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Grid.ColumnSpan="2" DragStarted="DockBoundsStart" DragDelta="DockMove" DragCompleted="DockBoundsDone" Cursor="SizeAll" ToolTip="拖动移动侧栏"><SystemThumb:Thumb.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></SystemThumb:Thumb.Template></SystemThumb:Thumb>
          <Border IsHitTestVisible="False" Background="#393222" CornerRadius="1" Width="30" Height="32"><TextBlock Text="匣" FontFamily="KaiTi" FontSize="21" Foreground="#B6C5A0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="九宫剑匣" FontFamily="KaiTi" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="机枢藏锋 · 任务有序" Foreground="#C0AD87" FontSize="10" Margin="0,3,0,0"/></StackPanel>
          <Button Grid.Column="2" Content="+" Padding="6,3" Background="Transparent" Click="AllSlotsClick" ToolTip="展开 / 收起完整槽位"/>
          <Button Grid.Column="3" Content="···" Padding="5,3" Background="Transparent" Click="MenuClick" ToolTip="设置、暂停与退出"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,11">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Summary" Text="把任务放在顺手的位置" FontSize="11" Foreground="#B9A783"/>
          <TextBlock Grid.Column="1" x:Name="CountLabel" Text="0 / 9" FontSize="10" Foreground="#9A8358"/>
        </Grid>
        <ScrollViewer x:Name="SlotsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <ItemsControl x:Name="SlotsList">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{Binding SurfaceColor}" BorderBrush="{Binding OutlineColor}" BorderThickness="1" CornerRadius="1" Margin="0,0,0,6" Padding="8,7" MinHeight="51" Cursor="Hand" Visibility="{Binding IsDisplayed, Converter={StaticResource BoolVisibility}}" MouseLeftButtonUp="SlotClick" MouseRightButtonUp="SlotMenu" MouseEnter="SlotEnter" MouseLeave="SlotLeave" ToolTip="{Binding Tooltip}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.ColumnSpan="4" Background="{x:Static local:WuxiaTheme.Wood}" Opacity="0.28" IsHitTestVisible="False"/><local:BaguaGlyph Grid.ColumnSpan="4" Width="40" Height="40" HorizontalAlignment="Right" Opacity="0.55" IsHitTestVisible="False" Visibility="{Binding IsDropTarget, Converter={StaticResource BoolVisibility}}"/>
                  <Border Width="2" Background="{Binding TagColor}" CornerRadius="1" Margin="0,2,0,2" Opacity="0.8" Visibility="{Binding Occupied, Converter={StaticResource BoolVisibility}}"/>
                  <Border Grid.Column="1" Background="#3A3120" BorderBrush="#8D7449" BorderThickness="1" CornerRadius="1" Width="22" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Inscription}" FontFamily="KaiTi" Foreground="{Binding NumberColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/></Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="5,0,3,0"><TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{Binding StateColor}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="2,1,0,0"><Button Content="×" Padding="4,0" FontSize="14" Click="RemoveClick" ToolTip="移出列表，保留终端窗口" Visibility="{Binding Occupied, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding ActivityLabel}" FontSize="9" Foreground="{Binding ActivityColor}"/><Ellipse Width="5" Height="5" Fill="{Binding StateColor}" HorizontalAlignment="Right" Margin="0,3,0,0" Visibility="{Binding Unread, Converter={StaticResource BoolVisibility}}"/></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Margin="0,6,0,0">
          <Button Click="OverviewClick" Padding="10,9" Background="#2C3B2B" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OverviewLabel" Text="全部排列" FontSize="11" Foreground="#C0D0A8"/><TextBlock Grid.Column="1" x:Name="OverviewShortcut" Text="Alt + 反引号" Foreground="#A38F61" FontSize="9"/></Grid></Button>
          <TextBlock x:Name="Hint" Text="拖动标题栏到槽位，松手收纳" Foreground="#B4A181" FontSize="10" TextWrapping="Wrap" Margin="1,10,0,0" MinHeight="27"/>
          <TextBlock x:Name="ShortcutHint" Text="Alt 1–9 直达 · Alt 滚轮选择" Foreground="#A18C66" FontSize="9" TextTrimming="CharacterEllipsis" Margin="1,3,0,1"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="MiniView" Visibility="Collapsed" Margin="-7,-3,-7,-3">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="匣" FontFamily="KaiTi" Foreground="#B6C5A0" FontSize="21" HorizontalAlignment="Center" Margin="0,0,0,9"/>
        <ItemsControl Grid.Row="1" x:Name="MiniSlots"><ItemsControl.ItemTemplate><DataTemplate>
          <Border Background="{Binding SurfaceColor}" BorderBrush="{Binding OutlineColor}" BorderThickness="1" CornerRadius="1" Height="27" Margin="0,0,0,5" Visibility="{Binding IsDisplayed, Converter={StaticResource BoolVisibility}}" MouseLeftButtonUp="SlotClick" MouseRightButtonUp="SlotMenu" Cursor="Hand" ToolTip="{Binding Tooltip}"><Grid><TextBlock Text="{Binding Inscription}" FontFamily="KaiTi" Foreground="{Binding NumberColor}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="4" Height="4" Fill="{Binding StateColor}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding Occupied, Converter={StaticResource BoolVisibility}}"/></Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button Grid.Row="2" Content="↗" Padding="0,5" Background="Transparent" Click="ExpandClick" ToolTip="展开任务栏"/>
      </Grid>
      <SystemThumb:Thumb xmlns:SystemThumb="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18" Margin="0,0,-11,-11" Cursor="SizeNWSE" DragStarted="DockBoundsStart" DragDelta="DockResize" DragCompleted="DockBoundsDone" ToolTip="拖动调整侧栏大小"><SystemThumb:Thumb.Template><ControlTemplate><Border Background="Transparent"><TextBlock Text="◢" Foreground="#D8B56B" FontSize="14"/></Border></ControlTemplate></SystemThumb:Thumb.Template></SystemThumb:Thumb>
    </Grid>
  </Border>
</Window>
